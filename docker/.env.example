# NewsGator configuration — copy to .env next to docker-compose.yml and adjust.
# docker-compose loads this whole file into the container (env_file), so every
# variable you set here reaches the app directly — no need to touch compose.
# Every value can also be overridden at runtime in the admin Settings GUI
# (stored in the DB, applied live) — EXCEPT env-set values, which are locked
# in the GUI and always win (env var > DB override > code default).

# --- Required ---
# Session-cookie signing secret. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# --- LLM (external OpenAI-compatible server: oMLX, Ollama, llama.cpp, LM Studio…) ---
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_MODEL=qwen2.5-32b-instruct
# Bearer token sent to the LLM server. Most local servers ignore it; set a real
# value only if YOUR server enforces authentication.
LLM_API_KEY=not-needed
# Embeddings endpoint (defaults to LLM_BASE_URL if unset) + model:
# EMBED_BASE_URL=http://host.docker.internal:8080/v1
EMBED_MODEL=bge-m3
# LLM request timeout in seconds (long articles on slow models need headroom):
# LLM_TIMEOUT_S=120
# Live LLM interaction trace on the Activity page (prompts/replies, in-memory
# only — never stored in the DB):
# LLM_TRACE_ENABLED=true
# LLM_TRACE_MAX_CHARS=8000   # per message, longer text is clamped

# --- Language ---
# All summaries/embeddings are produced in this language (ISO 639-1). GUI is English.
SUMMARY_LANGUAGE=en

# --- Vector store ---
# sqlite_vec (default, zero-ops) or qdrant (external server — never spun up here):
# VECTOR_BACKEND=sqlite_vec
# QDRANT_URL=http://qdrant.lan:6333
# QDRANT_API_KEY=

# --- Clustering thresholds (tune later via the Settings → feedback report) ---
# TAU_ATTACH=0.82
# TAU_GRAY=0.70
# FREEZE_AFTER_HOURS=72

# --- Ingestion ---
# RETENTION_DAYS=45
# FEED_DISABLE_AFTER_DAYS=7
# POLL_INTERVAL_MIN_MINUTES=15
# POLL_INTERVAL_MAX_MINUTES=60
# FULLTEXT_MIN_CHARS=400
# How often articles stuck mid-pipeline (LLM errors, restarts) are retried:
# BACKLOG_SWEEP_MINUTES=5

# --- Newsletter ingestion (per-user IMAP accounts, set up in the Settings GUI) ---
# Each user can point at an IMAP folder receiving newsletters; every sender
# becomes a mail feed and every article link found in a message is processed
# like an RSS entry (human-written intro preferred for new stories).
# MAIL_POLL_MINUTES=15           # how often all accounts are polled
# MAIL_MAX_MESSAGES_PER_POLL=20  # cap per account per poll (oldest first)
# NEWSLETTER_LLM_CLEAN=true     # one LLM call first deletes the non-news chrome
#                                # (intro, socials, sponsors, platform self-links)
#                                # from the full email before link extraction
# NEWSLETTER_LLM_EXTRACT=true    # one LLM call per newsletter maps links to their
#                                # intro text; false = code heuristic only

# --- Readeck integration (optional) ---
# Self-hosted read-later archive. When BOTH are set, a "Save to Readeck" action
# appears on stories: the story (headline + summary + all source links) is
# pushed as a permanent, self-contained bookmark that survives RETENTION_DAYS.
# READECK_BASE_URL=http://readeck.lan:8000
# READECK_TOKEN=

# --- Sharing ---
# Languages offered by the share button (comma-separated ISO 639-1 codes).
# Picking one translates the story headline + summary on demand via the LLM;
# "as is" sharing never calls the LLM.
# SHARE_LANGUAGES=en,fr,de,es,it,pt,nl

# --- Chatbot ---
# RAG question-answering over the story archive (/chat). Answers are grounded
# on retrieved story summaries; the question is embedded with EMBED_MODEL and
# matched against story centroids (ANN + exact cosine re-rank).
# CHAT_ENABLED=true
# CHAT_TOP_K=12          # stories handed to the LLM as grounding
# CHAT_CANDIDATES=40     # ANN candidates re-ranked per question

# --- Category suggestions ---
# The summarize LLM call may propose a new category when none of the current
# taxonomy fits well; recurring proposals surface to admins on the Settings
# page (Categories card), never auto-applied.
# CATEGORY_SUGGESTIONS_ENABLED=true
# CATEGORY_SUGGESTION_MIN_ARTICLES=5    # distinct articles before proposing
# CATEGORY_SUGGESTION_WINDOW_DAYS=30    # rolling window for the count

# --- Database (inside the container, points at the data volume) ---
# DATABASE_URL=sqlite+aiosqlite:////data/newsgator.db
